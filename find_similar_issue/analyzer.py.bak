"""Three-step similar issue hunting backed by run_opencode_task only."""

from __future__ import annotations

import asyncio
import json
import os
from dataclasses import dataclass
from typing import Any, Callable, Literal

from task_agent import run_opencode_task


CandidateConfidence = Literal["high", "medium", "low"]
FindingSeverity = Literal["critical", "high", "medium", "low", "none"]


PROMPT_GENERATION_SCHEMA: dict[str, Any] = {
    "type": "object",
    "properties": {
        "candidate_discovery_prompt": {"type": "string"},
        "candidate_audit_prompt": {"type": "string"},
    },
    "required": [
        "candidate_discovery_prompt",
        "candidate_audit_prompt",
    ],
    "additionalProperties": False,
}


CANDIDATE_DISCOVERY_SCHEMA: dict[str, Any] = {
    "type": "object",
    "properties": {
        "candidates": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "candidate_id": {"type": "string"},
                    "file_path": {"type": "string"},
                    "symbol": {"type": "string"},
                    "location_hint": {"type": "string"},
                    "code_snippet": {"type": "string"},
                    "similarity_reason": {"type": "string"},
                    "audit_focus": {"type": "string"},
                    "confidence": {
                        "type": "string",
                        "enum": ["high", "medium", "low"],
                    },
                },
                "required": [
                    "candidate_id",
                    "file_path",
                    "symbol",
                    "location_hint",
                    "code_snippet",
                    "similarity_reason",
                    "audit_focus",
                    "confidence",
                ],
                "additionalProperties": False,
            },
        },
    },
    "required": ["candidates"],
    "additionalProperties": False,
}


SIMILAR_ISSUE_VALIDATION_SCHEMA: dict[str, Any] = {
    "type": "object",
    "properties": {
        "candidate_id": {"type": "string"},
        "similar_issue_exists": {"type": "boolean"},
        "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low", "none"],
        },
        "title": {"type": "string"},
        "file_path": {"type": "string"},
        "symbol": {"type": "string"},
        "line": {"type": "integer"},
        "root_cause": {"type": "string"},
        "evidence": {"type": "string"},
        "attack_path": {"type": "string"},
        "similarity_analysis": {"type": "string"},
        "difference_analysis": {"type": "string"},
        "recommendation": {"type": "string"},
        "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"],
        },
    },
    "required": [
        "candidate_id",
        "similar_issue_exists",
        "severity",
        "title",
        "file_path",
        "symbol",
        "line",
        "root_cause",
        "evidence",
        "attack_path",
        "similarity_analysis",
        "difference_analysis",
        "recommendation",
        "confidence",
    ],
    "additionalProperties": False,
}


@dataclass(frozen=True)
class SimilarIssuePromptDescriptions:
    """Prompt descriptions generated from the known issue."""

    candidate_discovery_prompt: str
    candidate_audit_prompt: str

    def to_dict(self) -> dict[str, Any]:
        return {
            "candidate_discovery_prompt": self.candidate_discovery_prompt,
            "candidate_audit_prompt": self.candidate_audit_prompt,
        }


@dataclass(frozen=True)
class SimilarIssueCandidate:
    """One candidate location that may resemble the known issue."""

    candidate_id: str
    file_path: str
    symbol: str
    location_hint: str
    code_snippet: str
    similarity_reason: str
    audit_focus: str
    confidence: CandidateConfidence = "low"

    def to_dict(self) -> dict[str, Any]:
        return {
            "candidate_id": self.candidate_id,
            "file_path": self.file_path,
            "symbol": self.symbol,
            "location_hint": self.location_hint,
            "code_snippet": self.code_snippet,
            "similarity_reason": self.similarity_reason,
            "audit_focus": self.audit_focus,
            "confidence": self.confidence,
        }


@dataclass(frozen=True)
class SimilarIssueFinding:
    """Validation result for one candidate."""

    candidate_id: str
    similar_issue_exists: bool
    severity: FindingSeverity
    title: str
    file_path: str
    symbol: str
    line: int
    root_cause: str
    evidence: str
    attack_path: str
    similarity_analysis: str
    difference_analysis: str
    recommendation: str
    confidence: CandidateConfidence = "low"

    def to_dict(self) -> dict[str, Any]:
        return {
            "candidate_id": self.candidate_id,
            "similar_issue_exists": self.similar_issue_exists,
            "severity": self.severity,
            "title": self.title,
            "file_path": self.file_path,
            "symbol": self.symbol,
            "line": self.line,
            "root_cause": self.root_cause,
            "evidence": self.evidence,
            "attack_path": self.attack_path,
            "similarity_analysis": self.similarity_analysis,
            "difference_analysis": self.difference_analysis,
            "recommendation": self.recommendation,
            "confidence": self.confidence,
        }


@dataclass(frozen=True)
class FindSimilarIssueOptions:
    """Options for one similar issue hunt."""

    known_issue: str | dict[str, Any]
    search_scope: str = "当前工作区代码仓库"
    max_candidates: int = 20
    concurrency: int = 4
    required_capability: Literal["low", "high"] = "high"
    config_path: str | os.PathLike[str] | None = None
    output: Callable[[str], Any] | None = None
    cancel_event: Any = None


@dataclass(frozen=True)
class FindSimilarIssueResult:
    """Combined generated prompts, candidates, and validation findings."""

    prompt_descriptions: SimilarIssuePromptDescriptions
    candidates: list[SimilarIssueCandidate]
    findings: list[SimilarIssueFinding]

    def to_dict(self) -> dict[str, Any]:
        return {
            "prompt_descriptions": self.prompt_descriptions.to_dict(),
            "candidates": [candidate.to_dict() for candidate in self.candidates],
            "findings": [finding.to_dict() for finding in self.findings],
        }


class FindSimilarIssueRunner:
    """Run the three-step similar issue hunt through the public task API."""

    def __init__(self, options: FindSimilarIssueOptions):
        self.options = options
        self.known_issue_text = _format_known_issue(options.known_issue)
        self._validate_options()

    async def run(self) -> FindSimilarIssueResult:
        prompt_descriptions = await self._generate_prompt_descriptions()
        candidates = await self._discover_candidates(prompt_descriptions)
        if not candidates:
            return FindSimilarIssueResult(
                prompt_descriptions=prompt_descriptions,
                candidates=[],
                findings=[],
            )

        semaphore = asyncio.Semaphore(self.options.concurrency)
        findings = await asyncio.gather(
            *(
                self._validate_candidate_with_semaphore(
                    prompt_descriptions,
                    candidate,
                    semaphore,
                )
                for candidate in candidates
            )
        )
        return FindSimilarIssueResult(
            prompt_descriptions=prompt_descriptions,
            candidates=candidates,
            findings=list(findings),
        )

    async def _generate_prompt_descriptions(self) -> SimilarIssuePromptDescriptions:
        schema_text = json.dumps(
            PROMPT_GENERATION_SCHEMA,
            ensure_ascii=False,
            indent=2,
        )
        prompt = self._build_prompt_generation_prompt(schema_text)
        result = await run_opencode_task(
            task_name="similar issue prompt generation",
            task_type="variant_hunt",
            prompt=prompt,
            required_capability=self.options.required_capability,
            output_schema=PROMPT_GENERATION_SCHEMA,
            session_id=None,
            config_path=self.options.config_path,
            output=self.options.output,
            cancel_event=self.options.cancel_event,
        )
        if getattr(result, "status", "") != "success":
            raise RuntimeError(
                f"prompt generation ended with status {getattr(result, 'status', '')!r}"
            )
        structured = getattr(result, "structured", None)
        if not isinstance(structured, dict):
            raise TypeError("prompt generation did not return a JSON object")
        return _normalize_prompt_descriptions(structured)

    async def _discover_candidates(
        self,
        prompt_descriptions: SimilarIssuePromptDescriptions,
    ) -> list[SimilarIssueCandidate]:
        schema_text = json.dumps(
            CANDIDATE_DISCOVERY_SCHEMA,
            ensure_ascii=False,
            indent=2,
        )
        prompt = self._build_candidate_prompt(prompt_descriptions, schema_text)
        result = await run_opencode_task(
            task_name="similar issue candidate discovery",
            task_type="variant_hunt",
            prompt=prompt,
            required_capability=self.options.required_capability,
            output_schema=CANDIDATE_DISCOVERY_SCHEMA,
            session_id=None,
            config_path=self.options.config_path,
            output=self.options.output,
            cancel_event=self.options.cancel_event,
        )
        if getattr(result, "status", "") != "success":
            raise RuntimeError(
                f"candidate discovery ended with status {getattr(result, 'status', '')!r}"
            )
        structured = getattr(result, "structured", None)
        if not isinstance(structured, dict):
            raise TypeError("candidate discovery did not return a JSON object")
        return _normalize_candidates(
            structured.get("candidates", []),
            max_candidates=self.options.max_candidates,
        )

    async def _validate_candidate_with_semaphore(
        self,
        prompt_descriptions: SimilarIssuePromptDescriptions,
        candidate: SimilarIssueCandidate,
        semaphore: asyncio.Semaphore,
    ) -> SimilarIssueFinding:
        async with semaphore:
            return await self._validate_candidate(prompt_descriptions, candidate)

    async def _validate_candidate(
        self,
        prompt_descriptions: SimilarIssuePromptDescriptions,
        candidate: SimilarIssueCandidate,
    ) -> SimilarIssueFinding:
        schema_text = json.dumps(
            SIMILAR_ISSUE_VALIDATION_SCHEMA,
            ensure_ascii=False,
            indent=2,
        )
        prompt = self._build_validation_prompt(
            prompt_descriptions,
            candidate,
            schema_text,
        )
        result = await run_opencode_task(
            task_name=f"similar issue validation {candidate.candidate_id}",
            task_type="variant_hunt",
            prompt=prompt,
            required_capability=self.options.required_capability,
            output_schema=SIMILAR_ISSUE_VALIDATION_SCHEMA,
            session_id=None,
            config_path=self.options.config_path,
            output=self.options.output,
            cancel_event=self.options.cancel_event,
        )
        if getattr(result, "status", "") != "success":
            raise RuntimeError(
                f"candidate validation ended with status {getattr(result, 'status', '')!r}"
            )
        structured = getattr(result, "structured", None)
        if not isinstance(structured, dict):
            raise TypeError("candidate validation did not return a JSON object")
        return _normalize_finding(structured, fallback_candidate=candidate)

    def _build_prompt_generation_prompt(self, schema_text: str) -> str:
        return f"""\
你是网络安全代码审计 agent。你的任务不是直接审计代码，而是根据当前代码仓存在的历史网络安全问题，生成后续相似问题排查要使用的两段 prompt 描述。

当前代码仓存在的历史网络安全问题：
{self.known_issue_text}

任务目标：
1. 先分析历史问题的关键特征。这个关键特征必须能帮助下一个 agent 快速筛选可能产生疑似相似问题的地方，并输出为 `candidate_discovery_prompt`。
2. 再根据历史问题的根因，给出如何判断筛选出来的疑似问题处是否真实构成问题的一段判断方法描述，并输出为 `candidate_audit_prompt`。

生成要求：
- 输入中的历史问题通常包含问题描述、问题根因和问题代码；必须综合这三类信息提炼，不要只复述漏洞类型。
- `candidate_discovery_prompt` 是描述关键特征的语句，应突出可用于候选筛选的具体模式，例如可控输入、缺失校验、危险操作、调用上下文、数据结构、协议/业务场景、关键代码形态。
- `candidate_audit_prompt` 是判断方法描述，应基于问题根因说明如何确认候选处是否真的存在问题，例如数据是否可控、危险操作是否可达、缺失的校验是否仍然缺失、触发路径和利用条件是否成立。
- 两段描述都必须紧扣该历史问题，不要泛化成通用漏洞扫描任务。
- 不要在这一步输出候选点、审计结论或修复报告；只输出这两段 prompt 描述。
- 最终回复必须只包含一个严格符合 JSON Schema 的 JSON 对象，不要输出 Markdown 或解释文字。

目标范围：
{self.options.search_scope}

JSON Schema:
{schema_text}
"""

    def _build_candidate_prompt(
        self,
        prompt_descriptions: SimilarIssuePromptDescriptions,
        schema_text: str,
    ) -> str:
        return f"""\
你是网络安全代码审计 agent。你正在执行相似问题排查的候选发现步骤。

任务目标：
1. 使用“第一步 agent 生成的候选发现 prompt 描述”作为主要排查策略。
2. 基于已知漏洞描述，在目标范围中寻找疑似相似问题候选点。
3. 这一步只负责发现候选，不确认漏洞是否真实成立。
4. 输出候选列表 JSON，供下一步逐项并行审计。

第一步 agent 生成的候选发现 prompt 描述：
{prompt_descriptions.candidate_discovery_prompt}

硬性输出要求：
- 最多输出 {self.options.max_candidates} 个候选；没有候选时输出空数组。
- 每个候选必须是和已知漏洞高度相似且值得后续审计的位置。
- 最终回复必须只包含一个严格符合 JSON Schema 的 JSON 对象，不要输出 Markdown 或解释文字。

目标范围：
{self.options.search_scope}

已知漏洞描述：
{self.known_issue_text}

JSON Schema:
{schema_text}
"""

    def _build_validation_prompt(
        self,
        prompt_descriptions: SimilarIssuePromptDescriptions,
        candidate: SimilarIssueCandidate,
        schema_text: str,
    ) -> str:
        candidate_json = json.dumps(
            candidate.to_dict(),
            ensure_ascii=False,
            indent=2,
            sort_keys=True,
        )
        return f"""\
你是网络安全代码审计 agent。你正在执行相似问题排查的候选审计步骤。

任务目标：
1. 使用“第一步 agent 生成的候选审计 prompt 描述”作为主要审计策略。
2. 必须同时使用“已知漏洞描述”和“候选项 JSON”作为输入。
3. 针对这个单个候选位置审计当前代码，确认是否存在和已知漏洞同构或高度相似的问题。
4. 输出一个结构化 JSON 结论；不要审计其它候选项。

第一步 agent 生成的候选审计 prompt 描述：
{prompt_descriptions.candidate_audit_prompt}

硬性判定要求：
- 必须对比已知漏洞和候选项的根因、攻击者可控输入、缺失校验/鉴权/边界检查、危险操作、触发路径和业务语义。
- 只有候选问题的成因和利用条件与已知漏洞高度相似时，`similar_issue_exists` 才能为 true。
- `severity` 在没有相似问题时必须为 "none"。
- `evidence` 必须引用具体文件、函数、代码行为或数据流，不要只写主观判断。
- 最终回复必须只包含一个严格符合 JSON Schema 的 JSON 对象，不要输出 Markdown 或解释文字。

目标范围：
{self.options.search_scope}

已知漏洞描述：
{self.known_issue_text}

候选项 JSON：
{candidate_json}

JSON Schema:
{schema_text}
"""

    def _validate_options(self) -> None:
        if not self.known_issue_text.strip():
            raise ValueError("known_issue must not be empty")
        if not str(self.options.search_scope or "").strip():
            raise ValueError("search_scope must not be empty")
        if self.options.max_candidates < 1:
            raise ValueError("max_candidates must be >= 1")
        if self.options.concurrency < 1:
            raise ValueError("concurrency must be >= 1")
        if self.options.required_capability not in {"low", "high"}:
            raise ValueError("required_capability must be 'low' or 'high'")


async def find_similar_issue(
    known_issue: str | dict[str, Any] | FindSimilarIssueOptions,
    **overrides: Any,
) -> FindSimilarIssueResult:
    """Find and validate issues similar to a known issue."""
    if isinstance(known_issue, FindSimilarIssueOptions):
        if overrides:
            values = {**known_issue.__dict__, **overrides}
            options = FindSimilarIssueOptions(**values)
        else:
            options = known_issue
    else:
        options = FindSimilarIssueOptions(known_issue=known_issue, **overrides)
    return await FindSimilarIssueRunner(options).run()


def _normalize_prompt_descriptions(value: dict[str, Any]) -> SimilarIssuePromptDescriptions:
    prompt_descriptions = SimilarIssuePromptDescriptions(
        candidate_discovery_prompt=_clean_text(
            value.get("candidate_discovery_prompt")
        ),
        candidate_audit_prompt=_clean_text(value.get("candidate_audit_prompt")),
    )
    if not prompt_descriptions.candidate_discovery_prompt:
        raise ValueError("candidate_discovery_prompt must not be empty")
    if not prompt_descriptions.candidate_audit_prompt:
        raise ValueError("candidate_audit_prompt must not be empty")
    return prompt_descriptions


def _normalize_candidates(
    value: Any,
    *,
    max_candidates: int,
) -> list[SimilarIssueCandidate]:
    if not isinstance(value, list):
        return []

    candidates: list[SimilarIssueCandidate] = []
    for index, item in enumerate(value[:max_candidates], start=1):
        if not isinstance(item, dict):
            continue
        candidate_id = _clean_text(item.get("candidate_id")) or f"candidate-{index}"
        candidate = SimilarIssueCandidate(
            candidate_id=candidate_id,
            file_path=_clean_text(item.get("file_path")),
            symbol=_clean_text(item.get("symbol")),
            location_hint=_clean_text(item.get("location_hint")),
            code_snippet=_clean_text(item.get("code_snippet")),
            similarity_reason=_clean_text(item.get("similarity_reason")),
            audit_focus=_clean_text(item.get("audit_focus")),
            confidence=_clean_confidence(item.get("confidence")),
        )
        if candidate.file_path or candidate.symbol or candidate.location_hint:
            candidates.append(candidate)
    return candidates


def _normalize_finding(
    value: dict[str, Any],
    *,
    fallback_candidate: SimilarIssueCandidate,
) -> SimilarIssueFinding:
    exists = bool(value.get("similar_issue_exists"))
    severity = _clean_severity(value.get("severity"))
    if not exists:
        severity = "none"
    elif severity == "none":
        severity = "low"
    return SimilarIssueFinding(
        candidate_id=(
            _clean_text(value.get("candidate_id")) or fallback_candidate.candidate_id
        ),
        similar_issue_exists=exists,
        severity=severity,
        title=_clean_text(value.get("title")),
        file_path=_clean_text(value.get("file_path")) or fallback_candidate.file_path,
        symbol=_clean_text(value.get("symbol")) or fallback_candidate.symbol,
        line=_clean_int(value.get("line")),
        root_cause=_clean_text(value.get("root_cause")),
        evidence=_clean_text(value.get("evidence")),
        attack_path=_clean_text(value.get("attack_path")),
        similarity_analysis=_clean_text(value.get("similarity_analysis")),
        difference_analysis=_clean_text(value.get("difference_analysis")),
        recommendation=_clean_text(value.get("recommendation")),
        confidence=_clean_confidence(value.get("confidence")),
    )


def _format_known_issue(value: str | dict[str, Any]) -> str:
    if isinstance(value, str):
        return value.strip()
    try:
        return json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True)
    except TypeError:
        return str(value).strip()


def _clean_text(value: Any) -> str:
    if value is None:
        return ""
    return str(value).strip()


def _clean_int(value: Any) -> int:
    try:
        parsed = int(value)
    except (TypeError, ValueError):
        return 0
    return max(0, parsed)


def _clean_confidence(value: Any) -> CandidateConfidence:
    confidence = _clean_text(value).lower()
    if confidence in {"high", "medium", "low"}:
        return confidence  # type: ignore[return-value]
    return "low"


def _clean_severity(value: Any) -> FindingSeverity:
    severity = _clean_text(value).lower()
    if severity in {"critical", "high", "medium", "low", "none"}:
        return severity  # type: ignore[return-value]
    return "none"
